/**
 * 담임 운영 키트 — 구글 시트 연동 스크립트
 *
 * [설치]
 *  1. 설정을 담을 구글 시트를 하나 만든다
 *  2. 확장 프로그램 > Apps Script 를 열고, 이 파일 내용을 통째로 붙여넣고 저장
 *  3. 시트로 돌아와 새로고침 → 상단에 [담임키트] 메뉴가 생긴다
 *  4. [담임키트] > 시트 초기 세팅  을 실행 (권한 승인 필요)
 *  5. 배포 > 새 배포 > 유형 '웹 앱'
 *       - 실행 계정: 나
 *       - 액세스 권한: 모든 사용자
 *     → 나온 웹 앱 URL 을 앱 첫 화면에 붙여넣는다
 *
 * 시트 자체는 비공개로 두어도 된다. 웹 앱이 소유자 권한으로 대신 읽어준다.
 * 앱은 읽기만 하며, 이 스크립트도 쓰기 기능이 없다.
 */

var TABS = ['학급', '학생', '역할', '거리두기', '친구탐험', '반시간표', '정보시간표', '일과표']

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('담임키트')
    .addItem('시트 초기 세팅', 'setupSheets')
    .addItem('웹 앱 URL 확인', 'showWebAppUrl')
    .addToUi()
}

/** 앱이 호출하는 엔드포인트. 모든 탭을 그대로 JSON 으로 돌려준다. */
function doGet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet()
  var out = {}
  for (var i = 0; i < TABS.length; i++) {
    var sheet = ss.getSheetByName(TABS[i])
    out[TABS[i]] = sheet ? sheet.getDataRange().getDisplayValues() : []
  }
  return ContentService
    .createTextOutput(JSON.stringify({ ok: true, version: 1, tabs: out }))
    .setMimeType(ContentService.MimeType.JSON)
}

function showWebAppUrl() {
  var url = ScriptApp.getService().getUrl()
  SpreadsheetApp.getUi().alert(
    url
      ? '웹 앱 URL:\n\n' + url + '\n\n이 주소를 앱 첫 화면에 붙여넣으세요.'
      : '아직 배포되지 않았습니다. 배포 > 새 배포 > 웹 앱 으로 먼저 배포하세요.'
  )
}

/** 탭이 없으면 만들고, 비어 있으면 기본값을 채운다. 기존 내용은 건드리지 않는다. */
function setupSheets() {
  var ss = SpreadsheetApp.getActiveSpreadsheet()
  var created = []

  for (var i = 0; i < TABS.length; i++) {
    var name = TABS[i]
    var sheet = ss.getSheetByName(name)
    if (!sheet) {
      sheet = ss.insertSheet(name)
      created.push(name)
    }
    if (sheet.getLastRow() === 0) {
      writeRows_(sheet, DEFAULTS[name])
      sheet.setFrozenRows(1)
      sheet.getRange(1, 1, 1, sheet.getLastColumn()).setFontWeight('bold')
      sheet.autoResizeColumns(1, sheet.getLastColumn())
    }
  }

  var blank = ss.getSheetByName('시트1') || ss.getSheetByName('Sheet1')
  if (blank && ss.getSheets().length > TABS.length) ss.deleteSheet(blank)

  SpreadsheetApp.getUi().alert(
    created.length
      ? '세팅 완료. 새로 만든 탭: ' + created.join(', ') + '\n\n학생 탭에 명단을 채워 넣으세요.'
      : '모든 탭이 이미 있습니다.'
  )
}

function writeRows_(sheet, rows) {
  var width = 0
  for (var i = 0; i < rows.length; i++) width = Math.max(width, rows[i].length)
  var padded = rows.map(function (r) {
    var copy = r.slice()
    while (copy.length < width) copy.push('')
    return copy
  })
  sheet.getRange(1, 1, padded.length, width).setValues(padded)
}

